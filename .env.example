# --- База данных ---
# Локальная разработка (docker-compose поднимает PostgreSQL на 5435):
# DATABASE_URL=postgresql+psycopg2://monitor:monitor@127.0.0.1:5435/site_monitoring
# В docker-compose URL задаётся автоматически для сервиса db.

# --- Расписание (п.20 ТЗ: ежедневный сбор в 20:00–23:00) ---
SCHEDULER_ENABLED=true
SCHEDULE_HOUR=21
SCHEDULE_MINUTE=0
TIMEZONE=Europe/Moscow

# --- Парсинг ---
HTTP_TIMEOUT=25.0
HTTP_DELAY_SEC=1.0
HTTP_RETRIES=2
MAX_PAGES_PER_SITE=100

# --- Прокси (пусто = напрямую; применяется ко всем сайтам) ---
# Для одного сайта задаётся в интерфейсе: Конкуренты → кнопка «Прокси»
# Схемы: http://, socks5:// · логин/пароль: http://user:pass@host:port
PROXY_URL=

# --- Playwright (сайты на JavaScript: autoopt, truckdrive) ---
BROWSER_ENABLED=true
BROWSER_HEADLESS=true
# Локально без контейнера: BROWSER_EXECUTABLE_PATH=/home/sithortodox/chrome/google-chrome
# В контейнере: пусто (используется Chromium из playwright install)

# --- Аналитика ---
HISTORY_DAYS_REQUIRED_FOR_RATING=7
VANISHED_GRACE_DAYS=3
REPORT_TOP_N=50

# --- Прочее ---
APP_PORT=8000
DEBUG=false
AUTO_CREATE_TABLES=true
